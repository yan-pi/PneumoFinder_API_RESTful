# Python environment and bytecode
venv/
.venv/
.env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files
*.db
*.sqlite3
*.db-shm
*.db-wal
database/*.db
database/*.db-*
database/vectors/
database/chroma/

# Models (too large for git)
*.keras
models/*.keras
!models/.gitkeep

# System files
*.log
*.bak
*.swp
.DS_Store

# IDE configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Environment variables
.env

# Package artifacts
*.egg
*.egg-info/
dist/
build/
.eggs/

# Editor temp files
*~

# mise/uv artifacts
.mise.local.toml
uv.lock
.python-version

# ruff cache
.ruff_cache/

# Temporary and generated files
temp/
test_outputs/

# HuggingFace model offload cache (large temporary files)
cache/
cache/offload/

# Pipeline test results (regenerate after tests)
results/
results/pipeline_tests/

# Data directories (sample data tracked in data/samples/)
data/samples/*.jpeg
data/samples/*.jpg
data/samples/*.png
!data/samples/.gitkeep
imgs_pulmoes/
