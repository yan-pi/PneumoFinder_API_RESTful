# Twilio Configuration for WhatsApp Bot
# Get these credentials from https://www.twilio.com/console

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual Twilio credentials
# 3. Never commit the .env file to version control (it's in .gitignore)
